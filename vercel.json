{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.ghost-tax.com" }],
      "destination": "https://ghost-tax.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/pulse",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/master",
      "schedule": "30 8 * * 2-4"
    },
    {
      "path": "/api/cron/daily-brief",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/cron/outbound-orchestrator",
      "schedule": "0 8 * * 2-4"
    },
    {
      "path": "/api/cron/apollo-sync",
      "schedule": "15 6 * * *"
    }
  ]
}
